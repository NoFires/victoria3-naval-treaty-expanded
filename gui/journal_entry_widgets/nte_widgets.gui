# Naval Treaty Expanded - journal entry widgets (own file; overrides no vanilla gui)
@nte_ladder_width = 504

types nte_ladder_widget_types
{
	type nte_ladder_header = widget {
		size = { @nte_ladder_width 24 }

		textbox = {
			size = { 100% 100% }
			align = nobaseline
			fontsize = 16
			default_format = "#title"
			block "header_text" {}
		}
	}

	type nte_ladder_row = widget {
		size = { @nte_ladder_width 28 }

		background = {
			using = dark_area
			alpha = 0.25
		}

		# Gold tint marks the seat held by the country viewing this journal entry.
		background = {
			block "self_visible" {}
			texture = "gfx/interface/backgrounds/white.dds"
			color = { 0.85 0.72 0.35 1.0 }
			alpha = 0.18
		}

		widget = {
			block "flag_visible" {}
			size = { 27 18 }
			position = { 6 0 }
			parentanchor = vcenter

			tiny_flag = {
				block "flag_datacontext" {}
			}
		}

		textbox = {
			autoresize = yes
			align = nobaseline
			margin_left = 42
			parentanchor = vcenter
			fontsize = 15
			block "row_text" {}
		}
	}
	# Decree card (pattern of vanilla tsarpoints_decree_button, own type so other mods' gui overrides cannot break it).
	type nte_decree_card = widget {
		size = { 248 96 }
		alpha = "[TransparentIfFalse(ScriptedButton.IsPossible)]"
		tooltip = "nte_decree_card_tt"

		background = {
			using = entry_bg_fancy_dark
		}
		background = {
			visible = "[ScriptedButton.HasIcon]"
			alpha = 0.2
			using = top_illu_properties
			texture = "[ScriptedButton.GetIcon]"
		}

		textbox = {
			position = { 10 8 }
			autoresize = yes
			align = nobaseline
			fontsize = 16
			elide = right
			maximumsize = { 228 -1 }
			raw_text = "#b [ScriptedButton.GetName]#!"
		}

		# A real action button, as in vanilla tsarpoints_decree_button.
		button = {
			size = { 218 31 }
			position = { 0 -10 }
			parentanchor = bottom|hcenter
			using = default_button_action
			enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
			onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
			tooltip = "nte_decree_card_tt"

			textbox = {
				parentanchor = center
				autoresize = yes
				align = nobaseline
				fontsize = 15
				text = "nte_decree_enact"
			}
		}
	}
}

### WIDGETS
flowcontainer = {
	name = "widget_nte_gnl_ladder"
	direction = vertical
	parentanchor = hcenter
	visible = "[JournalEntry.GetCountry.IsValid]"
	spacing = 2
	margin = { 0 5 }

	divider_clean = {}

	nte_ladder_header = {
		blockoverride "header_text" {
			text = "nte_ladder_header"
		}
	}

	nte_ladder_row = {
		blockoverride "self_visible" {
			visible = "[GetScriptedGui('nte_gnl_rank_self_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'rank', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
		}
		blockoverride "flag_visible" {
			visible = "[GetScriptedGui('nte_gnl_rank_filled_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'rank', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
		}
		blockoverride "flag_datacontext" {
			datacontext = "[GetGlobalVariable('gnl_rank1_country').GetCountry]"
		}
		blockoverride "row_text" {
			text = "[JournalEntry.GetCountry.GetCustom('nte_rank1_line')]"
		}
	}

	nte_ladder_row = {
		blockoverride "self_visible" {
			visible = "[GetScriptedGui('nte_gnl_rank_self_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'rank', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
		}
		blockoverride "flag_visible" {
			visible = "[GetScriptedGui('nte_gnl_rank_filled_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'rank', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
		}
		blockoverride "flag_datacontext" {
